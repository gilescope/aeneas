VERSION 0.8
# Dev harness for the fork: build `aeneas` and the test runner from this checkout (not a
# commit), then run one `tests/src` file through charon and aeneas in the tools image that
# ../atoi_radix10's Earthfile builds (charon at this fork's pin, Lean, the backend).
#
#   earthly +test --FILE=join-early-exit.rs    # writes tests/lean/JoinEarlyExit.lean

build:
    FROM ocaml/opam@sha256:bbaac53e502f6602013d8967c3a54cfcb898b556f453ab72e8e23966c3c681df
    ENV LC_ALL=C.UTF-8
    ENV TZ=UTC
    RUN sudo apt-get update && sudo apt-get install -y --no-install-recommends libgmp-dev pkg-config \
        && sudo rm -rf /var/lib/apt/lists/*
    RUN opam install -y calendar core_unix domainslib easy_logging menhir \
          ocamlformat.0.27.0 ocamlgraph odoc ppx_deriving ppx_deriving_yojson \
          progress unionFind visitors yojson zarith logs \
        && opam clean -a -c -s --logs
    WORKDIR /home/opam/aeneas
    # charon-ml is a vendored dune package; its dune-project is the charon repo's root one.
    COPY charon/dune-project charon/dune charon/charon.opam charon/name_matcher_parser.opam charon/
    COPY --dir charon/charon-ml charon/
    COPY --dir src tests/test_runner ./
    RUN cd src && opam exec -- dune build main.exe
    RUN cd test_runner && opam exec -- dune build
    SAVE ARTIFACT src/_build/default/main.exe aeneas
    SAVE ARTIFACT test_runner/_build/default/run_test.exe test_runner

test:
    FROM ../atoi_radix10+tools
    ARG FILE=join-early-exit.rs
    # Extra aeneas flags, e.g. --AENEAS_OPTIONS="-log SymbolicToPureExpressions".
    ARG AENEAS_OPTIONS
    # Seconds before the run is killed (0: never), e.g. to collect a -log dump only.
    ARG TIMEOUT=0
    WORKDIR /aeneas
    COPY +build/aeneas +build/test_runner /opt/aeneas/
    COPY --dir tests/src tests/
    RUN mkdir -p tests/llbc tests/lean \
        && timeout "$TIMEOUT" test_runner /opt/aeneas/charon /opt/aeneas/aeneas tests/llbc "tests/src/$FILE" $AENEAS_OPTIONS 2>&1 | tee test.log
    SAVE ARTIFACT test.log AS LOCAL tests/build/test.log
    SAVE ARTIFACT tests/lean/*.lean AS LOCAL tests/lean/

# Type-checks the Lean generated by `+test` against the backend built in the tools image
# (`lake env` borrows that project's search path, so no second Mathlib checkout).
lean-check:
    FROM +test
    ARG FILE=join-early-exit.rs
    RUN f=$(ls tests/lean/*.lean | head -1) && cd /opt/aeneas/backends/lean \
        && lake env lean "/aeneas/$f" 2>&1 | tee /aeneas/lean-check.log
    SAVE ARTIFACT lean-check.log AS LOCAL tests/build/lean-check.log

# Every test file through charon and aeneas, continuing past failures; the generated Lean is
# written over tests/lean so `git diff` shows what the change to the compiler altered.
test-all:
    FROM ../atoi_radix10+tools
    WORKDIR /aeneas
    COPY +build/aeneas +build/test_runner /opt/aeneas/
    COPY --dir tests/src tests/
    RUN mkdir -p tests/llbc tests/lean && : > failures.txt \
        && for f in tests/src/*.rs; do \
             test_runner /opt/aeneas/charon /opt/aeneas/aeneas tests/llbc "$f" > "run.log" 2>&1 \
               || { echo "$f" >> failures.txt; tail -20 run.log; }; \
           done; echo "failed: $(wc -l < failures.txt)"; cat failures.txt
    SAVE ARTIFACT failures.txt AS LOCAL tests/build/failures.txt
    SAVE ARTIFACT tests/lean/*.lean AS LOCAL tests/lean/
