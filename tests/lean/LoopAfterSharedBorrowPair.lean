def test_loops : Result Unit := do
  let b := Array.repeat 32#usize 0#u8
  let b1 ← Array.update b 0#usize 2#u8
  let b2 ← Array.update b1 8#usize 3#u8
  let i ← chunks_then_loop b2 (Array.make 3#usize [ 5#u64, 7#u64, 11#u64 ])
  let i1 ← 2#u64 * 5#u64
  let i2 ← 3#u64 * 7#u64
  let i3 ← i1 + i2
  massert (i = i3)
  let i4 ←
    chunks_only_then_loop b2 (Array.make 3#usize [ 5#u64, 7#u64, 11#u64 ])
  let i5 ← 2#u64 + 7#u64
  let i6 ← i5 + 22#u64
  massert (i4 = i6)
  let i7 ← from_fn_then_loop b2 (Array.make 3#usize [ 5#u64, 7#u64, 11#u64 ])
  let i8 ← i1 + i2
  massert (i7 = i8)
  let i9 ← split_then_loop b2 (Array.make 3#usize [ 5#u64, 7#u64, 11#u64 ])
  let i10 ← i5 + 22#u64
  massert (i9 = i10)
  let i11 ←
    chunks_ref_then_loop b2 (Array.make 3#usize [ 5#u64, 7#u64, 11#u64 ])
  let i12 ← i5 + 22#u64
  massert (i11 = i12)
  let i13 ← chunks_no_loop b2
  massert (i13 = 2#u64)

